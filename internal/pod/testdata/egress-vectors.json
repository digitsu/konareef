    },
    {
      "name": "plain http to a host declared on port 80 is declared but still non-TLS",
      "manifest": "[network]\negress = [\"plain.example.com:80\"]\n\n[directive]\ntask = \"Fetch http://plain.example.com/x\"",
      "files": {},
      "findings": [
