    {
      "name": "gateway only (OD-2 a)",
      "manifest": "[[network.gateway]]\nhost = \"api.example.com\"\nsecret = \"K\"\nauth = \"bearer\"\nmax_calls = 1",
      "declared": true,
      "rules": [
        {
          "host": "api.example.com",
          "port": 443,
          "wildcard": false
        }
      ],
      "hash_group": "gateway"
    },
    {
      "name": "sealed-grants marker only",
      "manifest": "[network]\nsealed_grants = \"konareef-sealed-grants/v1\"",
      "declared": true,
      "rules": [],
      "hash_group": "bare"
    }
  ],
  "findings": [
    {
      "name": "undeclared host in inline directive.task",
      "manifest": "[directive]\ntask = \"Fetch https://evil.example.com/x\"",
      "files": {},
      "findings": [
        {
          "code": "undeclared_host",
          "host": "evil.example.com",
          "port": 443,
          "source_class": "manifest"
        }
      ]
    },
    {
      "name": "declared exact host referenced, no finding",
      "manifest": "[network]\negress = [\"good.example.com\"]\n\n[directive]\ntask = \"Fetch https://good.example.com/x\"",
      "files": {},
      "findings": []
    },
    {
      "name": "wildcard declared; declared_unused never fires for a wildcard",
      "manifest": "[network]\negress = [\"*.example.com\"]",
      "files": {},
      "findings": [
        {
          "code": "wildcard_declared",
          "host": "*.example.com",
          "port": 443,
          "source_class": "manifest"
        }
      ]
    },
    {
      "name": "IP literal declared",
      "manifest": "[network]\negress = [\"127.0.0.1\"]",
      "files": {},
      "findings": [
        {
          "code": "ip_literal_declared",
          "host": "127.0.0.1",
          "port": 443,
          "source_class": "manifest"
        },
        {
          "code": "declared_unused",
          "host": "127.0.0.1",
          "port": 443,
          "source_class": "manifest"
        }
      ]
    },
    {
      "name": "packed-integer IP literal declared",
      "manifest": "[network]\negress = [\"2130706433\"]",
      "files": {},
      "findings": [
        {
          "code": "ip_literal_declared",
          "host": "2130706433",
          "port": 443,
          "source_class": "manifest"
        },
        {
          "code": "declared_unused",
          "host": "2130706433",
          "port": 443,
          "source_class": "manifest"
        }
      ]
    },
    {
      "name": "non-443 declared entry",
      "manifest": "[network]\negress = [\"example.com:22\"]",
      "files": {},
      "findings": [
        {
          "code": "non_tls_port",
          "host": "example.com",
          "port": 22,
          "source_class": "manifest"
        },
        {
          "code": "declared_unused",
          "host": "example.com",
          "port": 22,
          "source_class": "manifest"
        }
      ]
    },
    {
      "name": "non-443 gateway entry counts as a declaration and is flagged the same way",
      "manifest": "[[network.gateway]]\nhost = \"api.example.com:8443\"\nsecret = \"K\"\nauth = \"bearer\"\nmax_calls = 1",
      "files": {},
      "findings": [
        {
          "code": "non_tls_port",
          "host": "api.example.com",
          "port": 8443,
          "source_class": "manifest"
        },
        {
          "code": "declared_unused",
          "host": "api.example.com",
          "port": 8443,
          "source_class": "manifest"
        }
      ]
    },
    {
      "name": "plain http scheme adds non_tls_port beside undeclared_host",
      "manifest": "[directive]\ntask = \"Fetch http://plain.example.com/x\"",
      "files": {},
      "findings": [
        {
          "code": "undeclared_host",
          "host": "plain.example.com",
          "port": 80,
          "source_class": "manifest"
        },
        {
