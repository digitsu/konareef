    {
      "name": "uppercase scheme is still a URL",
      "manifest": "[directive]\ntask = \"HTTPS://Shout.Example.com/x\"",
      "files": {},
      "findings": [
        {
          "code": "undeclared_host",
          "host": "shout.example.com",
          "port": 443,
          "source_class": "manifest"
        }
      ]
    },
    {
      "name": "a vertical tab ends a URL, as whitespace does",
      "manifest": "[network]\negress = [\"api.example.com\"]\n\n[[context.prompts]]\npath = \"./p.md\"",
      "files": {
        "p.md": "https://api.example.com/p\u000bhttps://evil.example.net/x"
      },
      "findings": [
        {
          "code": "undeclared_host",
          "host": "evil.example.net",
          "port": 443,
          "source_class": "prompt"
        }
      ]
    },
    {
      "name": "a vertical tab ends a declared memory URL's authority",
      "manifest": "[network]\negress = [\"api.example.com\"]\n\n[[context.memory]]\nkind = \"http\"\nurl = \"https://api.example.com\\u000B.evil.net/\"",
      "files": {},
      "findings": [],
      "safety_check_stricter": true,
      "note": "The review ends the authority at the vertical tab and sees a declared host. konareef's listing pre-check refuses the whole URL because net/url rejects the control byte. The pre-check is stricter than the server here, which is the safe direction."
    }
