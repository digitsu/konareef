          "code": "undeclared_host",
          "host": "{{host}}",
          "port": 443,
          "source_class": "manifest"
        },
        {
          "code": "undeclared_host",
          "host": "${target}",
          "port": 443,
          "source_class": "manifest"
        }
      ]
    },
    {
      "name": "platform host takes precedence over undeclared_host",
      "manifest": "[directive]\ntask = \"curl https://api.anthropic.com/v1/messages\"",
      "files": {},
