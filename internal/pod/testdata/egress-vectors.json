  "declaration_presence": [
    {
      "name": "absent",
      "manifest": "[pod]\nname = \"p\"",
      "declared": false,
      "rules": [],
      "hash_group": "absent"
    },
    {
      "name": "bare table",
      "manifest": "[network]",
      "declared": true,
      "rules": [],
      "hash_group": "bare"
    },
    {
      "name": "empty egress",
      "manifest": "[network]\negress = []",
      "declared": true,
      "rules": [],
      "hash_group": "empty"
    },
    {
      "name": "one exact host",
      "manifest": "[network]\negress = [\"api.example.com\"]",
      "declared": true,
      "rules": [
        {
          "host": "api.example.com",
          "port": 443,
          "wildcard": false
        }
      ],
      "hash_group": "one"
    },
    {
      "name": "wildcard and port",
      "manifest": "[network]\negress = [\"*.example.com\", \"svc.example.com:8443\"]",
      "declared": true,
