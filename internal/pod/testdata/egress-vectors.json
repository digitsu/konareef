          "host": "plain.example.com",
          "port": 80,
          "source_class": "manifest"
        }
      ]
    },
    {
      "name": "dynamic host template placeholder is reported as its literal text",
      "manifest": "[directive]\ntask = \"curl https://{{HOST}}/webhook and https://${TARGET}/x\"",
      "files": {},
