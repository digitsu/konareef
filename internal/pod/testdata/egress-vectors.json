  "breadth": {
    "_comment": "Egress breadth rules for a run that no egress review covers. public_suffix_wildcard: the entry is refused (egress_wildcard_public_suffix) when it is a '*.' wildcard whose base is (a) a public suffix under the PSL algorithm (exception rule, then exact rule, then a wildcard rule one label up, then the default rule '*' for any single label), or (b) a proper ancestor of any PSL rule: of an exact rule, of an exception rule, or a wildcard rule's base or one of its ancestors (owner ruling 2026-10-09). Both the ICANN and PRIVATE sections count. Unicode PSL rules are compared in their ASCII (xn--) form. rule_count: the number of distinct authorities in [network].egress (normalized host and numeric port; port 443 by default; a wildcard counts as one), and whether it is above limit (egress_rule_limit_exceeded).",
    "psl": {
      "upstream": "https://github.com/publicsuffix/list",
      "file": "public_suffix_list.dat",
      "commit": "3929462652695bad04f0a27afb600974014a3c8b",
      "version": "publicsuffix/list@3929462652695bad04f0a27afb600974014a3c8b",
      "sha256": "2919eb9803c91a3f73a507cc6fedc934de005543c22c4016f72e3343de5dd6e7",
      "sections": [
        "ICANN",
        "PRIVATE"
      ]
    },
    "rule_limit_unreviewed": 16,
    "public_suffix_wildcard": [
      {
        "entry": "*.com:443",
        "public_suffix_wildcard": true
      },
      {
        "entry": "*.co.uk:443",
        "public_suffix_wildcard": true
      },
      {
        "entry": "*.sch.uk:443",
        "public_suffix_wildcard": true,
        "note": "the base of the ICANN wildcard rule *.sch.uk"
      },
      {
        "entry": "*.io:443",
        "public_suffix_wildcard": true
      },
      {
        "entry": "*.uk:443",
        "public_suffix_wildcard": true
      },
      {
        "entry": "*.com",
        "public_suffix_wildcard": true,
        "note": "the port defaults to 443 and does not change the answer"
      },
      {
        "entry": "*.COM.:443",
        "public_suffix_wildcard": true,
        "note": "the base is normalized: ASCII lowercase, one trailing dot removed"
      },
      {
        "entry": "*.zz-unlisted-tld:443",
        "public_suffix_wildcard": true,
