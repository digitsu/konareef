          "host": "api.anthropic.com",
          "port": 443,
          "source_class": "manifest"
        }
      ]
    },
    {
      "name": "explicitly declared platform host is not reported",
      "manifest": "[network]\negress = [\"api.anthropic.com\"]\n\n[directive]\ntask = \"curl https://api.anthropic.com/v1/messages\"",
      "files": {},
      "findings": []
