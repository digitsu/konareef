{
  "format": "konareef-egress-vectors/v1",
  "_comment": "Shared egress conformance vectors (K4-01). internal/pod/egress_review_test.go checks the konareef scanner against this file. scripts/check_egress_vectors.exs checks the reef-core scanner (EgressDeclaration and EgressScanner at a git ref) against the same file. When both pass, the client and the server agree on every case below. A change here needs a matching change on the other side in a linked MR. scanner_version and policy_version name the reef-core scanner constants these expectations were checked against. Findings are compared as sets, because neither side promises an order.",
  "scanner_version": "v1",
  "policy_version": "v1",
  "platform_host": "api.anthropic.com:443",
  "host_matching": [
    {
      "declared": "api.example.com",
      "host": "api.example.com",
      "port": 443,
      "allowed": true
    },
    {
      "declared": "api.example.com",
      "host": "api.example.com",
      "port": 8080,
      "allowed": false
    },
    {
      "declared": "api.example.com:8080",
      "host": "api.example.com",
      "port": 8080,
      "allowed": true
    },
    {
      "declared": "api.example.com:0443",
      "host": "api.example.com",
      "port": 443,
      "allowed": true,
      "note": "ports compare as numbers"
    },
    {
      "declared": "api.example.com:0",
      "host": "api.example.com",
      "port": 443,
      "allowed": false,
      "note": "a port outside 1..65535 is not a port; the whole entry is read as a host"
    },
    {
      "declared": "*.example.com",
      "host": "api.example.com",
      "port": 443,
      "allowed": true
    },
    {
      "declared": "*.example.com",
      "host": "a.b.example.com",
      "port": 443,
      "allowed": true
    },
    {
      "declared": "*.example.com",
      "host": "example.com",
      "port": 443,
      "allowed": false,
      "note": "a wildcard never matches the apex"
    },
    {
      "declared": "*.example.com",
      "host": "badexample.com",
      "port": 443,
      "allowed": false,
      "note": "a wildcard never matches an unrelated suffix"
    },
    {
      "declared": "*.example.com",
      "host": "api.example.com.evil.net",
      "port": 443,
      "allowed": false
    },
    {
      "declared": "*.example.com:8443",
      "host": "api.example.com",
      "port": 443,
      "allowed": false
    },
    {
      "declared": "API.Example.com.",
      "host": "api.example.com",
      "port": 443,
      "allowed": true,
      "note": "lowercased, one trailing dot stripped"
    },
    {
      "declared": "api.example.com",
      "host": "API.EXAMPLE.COM.",
      "port": 443,
      "allowed": true,
      "note": "the requested host is normalized the same way"
    },
    {
      "declared": "[::1]:8443",
      "host": "[::1]",
      "port": 8443,
      "allowed": true,
      "note": "bracketed IPv6"
    },
    {
      "declared": "[::1]",
      "host": "[::1]",
      "port": 443,
      "allowed": true
    }
  ],
